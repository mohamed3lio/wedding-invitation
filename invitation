<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="Elegant Wedding Invitation Website Template - Fully customizable for your special day.">
  <title>Elegant Wedding Invitation | Demo Template</title>
  <!-- Google Fonts: Elegant serif + sans-serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #fefaf5;
      font-family: 'Montserrat', sans-serif;
      color: #4a3b2c;
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* luxury color palette - original */
    :root {
      --ivory: #fef9ef;
      --white: #ffffff;
      --champagne: #e8d9c5;
      --champagne-gold: #c9b28b;
      --soft-beige: #f2e6d8;
      --gold-accent: #bfa37c;
    }

    h1, h2, h3, .hero-name, .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ========== ENVELOPE OVERLAY - Original Style ========== */
    .envelope-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #fff9f2 0%, #fef5ea 100%);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 1s ease, visibility 1s ease;
    }

    .envelope-overlay.hide {
      opacity: 0;
      visibility: hidden;
    }

    .envelope {
      position: relative;
      width: 320px;
      height: 220px;
      background: #fef7ef;
      border-radius: 12px;
      box-shadow: 0 25px 45px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(191, 163, 124, 0.3);
      transition: transform 0.4s ease;
      animation: softFloat 2.5s infinite alternate;
    }

    @keyframes softFloat {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-12px); }
    }

    .envelope:hover {
      transform: scale(1.02) translateY(-5px);
    }

    .envelope-flap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0;
      border-top: 110px solid #e8d9c5;
      border-left: 160px solid transparent;
      border-right: 160px solid transparent;
      border-radius: 12px 12px 0 0;
    }

    .envelope-body {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 110px;
      background: #fef7ef;
      border-radius: 0 0 12px 12px;
      border-top: 1px solid rgba(191, 163, 124, 0.2);
    }

    .envelope-heart {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 2.5rem;
      opacity: 0.7;
      color: #c9af8b;
      z-index: 3;
      pointer-events: none;
    }

    /* Floating hearts */
    .floating-heart-env {
      position: absolute;
      font-size: 1.4rem;
      pointer-events: none;
      animation: floatHeartEnv 2.5s ease-out forwards;
      z-index: 10000;
    }

    @keyframes floatHeartEnv {
      0% { transform: translateY(0) scale(0.6); opacity: 1; }
      100% { transform: translateY(-180px) scale(1.3); opacity: 0; }
    }

    .main-content {
      opacity: 0;
      transition: opacity 1.2s ease;
    }
    .main-content.show { opacity: 1; }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      background: linear-gradient(135deg, #fff9f2 0%, #fef5ea 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .floral-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23e8d9c5" fill-opacity="0.15" d="M0,256L48,240C96,224,192,192,288,176C384,160,480,160,576,176C672,192,768,224,864,224C960,224,1056,192,1152,176C1248,160,1344,160,1392,160L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
      background-repeat: no-repeat;
      background-position: bottom;
      background-size: contain;
      opacity: 0.6;
    }

    .hero-content {
      z-index: 2;
      animation: fadeInUp 1.2s ease-out;
    }

    .hero-name {
      font-size: clamp(3rem, 10vw, 5.8rem);
      font-weight: 600;
      color: #3e2c23;
      letter-spacing: 0.08em;
      margin-bottom: 1rem;
      text-transform: uppercase;
    }

    .hero-sub {
      font-size: clamp(1rem, 4vw, 1.4rem);
      font-weight: 300;
      letter-spacing: 0.3em;
      margin-bottom: 1.5rem;
      color: #9b7b5c;
      text-transform: uppercase;
    }

    .hero-date {
      font-size: clamp(1.2rem, 5vw, 1.8rem);
      font-family: 'Cormorant Garamond', serif;
      color: #b7926c;
      border-top: 1px solid rgba(191, 163, 124, 0.4);
      display: inline-block;
      padding-top: 1rem;
      margin-top: 0.5rem;
    }

    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(40px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    section {
      padding: 90px 0;
      border-bottom: 1px solid rgba(191, 163, 124, 0.2);
    }

    .section-title {
      text-align: center;
      font-size: 2.8rem;
      margin-bottom: 3rem;
      color: #4d3624;
      position: relative;
      display: inline-block;
      width: 100%;
    }

    .section-title:after {
      content: '';
      display: block;
      width: 70px;
      height: 2px;
      background: var(--champagne-gold);
      margin: 0.8rem auto 0;
    }

    /* Countdown */
    .countdown-wrapper {
      background: var(--white);
      box-shadow: 0 20px 35px -15px rgba(0,0,0,0.05);
      border-radius: 28px;
      padding: 40px 20px;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }

    .countdown {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 2rem;
    }

    .time-box {
      background: var(--ivory);
      width: 110px;
      padding: 1.2rem 0;
      border-radius: 20px;
      box-shadow: 0 5px 12px rgba(0,0,0,0.02);
    }

    .time-number {
      font-size: 2.8rem;
      font-weight: 500;
      font-family: 'Cormorant Garamond', serif;
      color: #b48c5c;
      line-height: 1;
    }

    .time-label {
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 2px;
      font-weight: 500;
      color: #8b6f50;
    }

    .story-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 3rem;
      align-items: center;
      justify-content: center;
    }

    .story-text {
      flex: 1;
      min-width: 260px;
    }

    .story-text p {
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 1.2rem;
      font-weight: 300;
      color: #4a3b2c;
    }

    .story-img {
      flex: 1;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 25px 35px -12px rgba(0,0,0,0.1);
      background: #f5ede3;
      min-height: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .placeholder-icon {
      font-size: 5rem;
      color: #c9b28b;
      opacity: 0.6;
    }

    .event-card {
      background: var(--white);
      padding: 2rem;
      border-radius: 32px;
      text-align: center;
      max-width: 650px;
      margin: 0 auto;
      box-shadow: 0 20px 30px -10px rgba(0,0,0,0.05);
      border: 1px solid rgba(191, 163, 124, 0.3);
    }

    .event-detail {
      margin: 1rem 0;
      font-size: 1.2rem;
      font-weight: 500;
      color: #4a3b2c;
    }

    .venue-btn {
      display: inline-block;
      background: transparent;
      border: 1.5px solid var(--gold-accent);
      padding: 12px 30px;
      border-radius: 50px;
      font-weight: 500;
      color: #5a3f2a;
      text-decoration: none;
      margin-top: 1.2rem;
      cursor: pointer;
      font-family: 'Montserrat', sans-serif;
      transition: 0.3s;
    }

    .venue-btn:hover {
      background: var(--gold-accent);
      color: white;
      border-color: var(--gold-accent);
    }

    .guest-message {
      background: var(--soft-beige);
      border-radius: 32px;
      padding: 3rem 2rem;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
    }

    .guest-message p {
      font-size: 1.5rem;
      line-height: 1.8;
      font-family: 'Cormorant Garamond', serif;
      color: #5a3f2a;
      font-weight: 500;
    }

    .footer {
      text-align: center;
      padding: 50px 20px 40px;
      background: #fef7ef;
      color: #8a6f53;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      border-top: 1px solid #e8ddcf;
    }

    .heart {
      font-size: 1.2rem;
      margin: 0 0.2rem;
      color: #bfa37c;
    }

    .music-control {
      position: fixed;
      bottom: 25px;
      right: 25px;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
      border-radius: 50%;
      width: 55px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      border: 1px solid var(--champagne-gold);
      transition: all 0.3s ease;
    }

    .music-control svg {
      width: 28px;
      height: 28px;
      stroke: #8b6f50;
      stroke-width: 1.5;
      fill: none;
    }

    .music-control.playing svg path {
      fill: #8b6f50;
      stroke: #8b6f50;
    }

    @media (max-width: 768px) {
      section { padding: 60px 0; }
      .countdown { gap: 1rem; }
      .time-box { width: 70px; padding: 0.8rem 0; }
      .time-number { font-size: 1.9rem; }
      .section-title { font-size: 2.2rem; }
      .story-grid { flex-direction: column; }
      .guest-message p { font-size: 1.2rem; }
      .envelope { width: 260px; height: 180px; }
      .envelope-flap { border-left: 130px solid transparent; border-right: 130px solid transparent; border-top: 90px solid #e8d9c5; }
      .envelope-body { height: 90px; }
      .music-control { width: 45px; height: 45px; }
    }
  </style>
</head>
<body>

<!-- ORIGINAL ELEGANT ENVELOPE -->
<div id="envelopeOverlay" class="envelope-overlay">
  <div class="envelope">
    <div class="envelope-flap"></div>
    <div class="envelope-body"></div>
    <div class="envelope-heart">❤️</div>
  </div>
</div>

<!-- MAIN CONTENT - Generic Demo Version with Original Colors -->
<div id="mainContent" class="main-content">
  <section class="hero" id="home">
    <div class="floral-bg"></div>
    <div class="hero-content container">
      <h1 class="hero-name">Groom & Bride</h1>
      <div class="hero-sub">We're Getting Married</div>
      <div class="hero-date">Wedding Date</div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">The Celebration Begins</h2>
      <div class="countdown-wrapper">
        <div class="countdown" id="countdown">
          <div class="time-box"><div class="time-number" id="days">00</div><div class="time-label">Days</div></div>
          <div class="time-box"><div class="time-number" id="hours">00</div><div class="time-label">Hours</div></div>
          <div class="time-box"><div class="time-number" id="minutes">00</div><div class="time-label">Minutes</div></div>
          <div class="time-box"><div class="time-number" id="seconds">00</div><div class="time-label">Seconds</div></div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">Our Story</h2>
      <div class="story-grid">
        <div class="story-text">
          <p>This is a sample story section. You can replace this text with your own love story. A beautiful narrative about how you met, your journey, and your dreams together.</p>
          <p>Every couple has a unique story worth sharing with their loved ones. This template allows you to personalize every detail to match your style and personality.</p>
          <p>Today, as you step into a new chapter of your lives, you can invite your guests to share this moment that will continue as a lifetime of love, joy, and togetherness.</p>
        </div>
        <div class="story-img">
          <div class="placeholder-icon">📸❤️</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">Event Details</h2>
      <div class="event-card">
        <div class="event-detail"><strong>📅 Date:</strong> Your Wedding Date</div>
        <div class="event-detail"><strong>⏰ Time:</strong> Ceremony & Reception</div>
        <div class="event-detail"><strong>📍 Venue:</strong> Your Venue Name</div>
        <button id="mapBtn" class="venue-btn">✨ Open Google Maps ✨</button>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="guest-message">
        <p>🤍 Your presence honors us and fills our hearts with joy 🤍</p>
        <p style="margin-top: 1rem; font-size: 1.2rem;">Having you with us on our most beautiful day means the world to us. Please do not deprive us of sharing this timeless moment with you.</p>
        <p style="margin-top: 1.5rem;">We look forward to seeing you all 🌸</p>
      </div>
    </div>
  </section>

  <footer class="footer">
    <p>Thank you for celebrating with us</p>
    <p style="margin-top: 1rem; font-size: 1.4rem;">Groom <span class="heart">❤️</span> Bride</p>
    <p style="margin-top: 1.5rem; font-size: 0.8rem; letter-spacing: 1px;">Forever begins</p>
  </footer>

  <div id="musicControl" class="music-control playing">
    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18V5l12-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="18" cy="16" r="3" />
      <path d="M9 12l12-2" />
    </svg>
  </div>
</div>

<audio id="bgMusic" loop preload="auto">
  <source src="https://files.catbox.moe/t2991o.mp3" type="audio/mpeg">
</audio>

<script>
  (function() {
    function createEnvelopeHeart() {
      const heart = document.createElement('div');
      heart.className = 'floating-heart-env';
      heart.innerHTML = ['❤️', '🤍', '💗', '💖', '💕', '✨'][Math.floor(Math.random() * 6)];
      heart.style.left = Math.random() * 80 + 10 + '%';
      heart.style.top = Math.random() * 60 + 20 + '%';
      heart.style.fontSize = (Math.random() * 1.3 + 0.8) + 'rem';
      heart.style.position = 'fixed';
      heart.style.pointerEvents = 'none';
      heart.style.zIndex = '10001';
      document.body.appendChild(heart);
      setTimeout(() => { heart.remove(); }, 2800);
    }

    let heartInterval = null;
    let musicStarted = false;
    const envelopeOverlay = document.getElementById('envelopeOverlay');
    const mainContent = document.getElementById('mainContent');
    const bgAudio = document.getElementById('bgMusic');
    const musicControl = document.getElementById('musicControl');
    
    bgAudio.volume = 0.45;
    
    function startMusicWithSkip() {
      if (musicStarted) return;
      musicStarted = true;
      const playPromise = bgAudio.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          bgAudio.currentTime = 3;
          if(musicControl) musicControl.classList.add('playing');
        }).catch(e => {
          console.log("Audio play error:", e);
          musicStarted = false;
        });
      }
    }
    
    envelopeOverlay.addEventListener('click', (e) => {
      startMusicWithSkip();
      envelopeOverlay.classList.add('hide');
      mainContent.classList.add('show');
      
      if (heartInterval) clearInterval(heartInterval);
      heartInterval = setInterval(() => { createEnvelopeHeart(); }, 380);
      setTimeout(() => { if (heartInterval) clearInterval(heartInterval); }, 10000);
      
      document.querySelectorAll('section').forEach(section => {
        section.style.opacity = '1';
        section.style.transform = 'translateY(0)';
      });
    });
    
    // Generic countdown (1 year from now for demo)
    const demoDate = new Date();
    demoDate.setFullYear(demoDate.getFullYear() + 1);
    demoDate.setMonth(5);
    demoDate.setDate(15);
    const weddingDate = demoDate.getTime();
    
    function updateCountdown() {
      const now = new Date().getTime();
      const distance = weddingDate - now;
      if (distance < 0) {
        document.getElementById('days').innerText = '00';
        document.getElementById('hours').innerText = '00';
        document.getElementById('minutes').innerText = '00';
        document.getElementById('seconds').innerText = '00';
        return;
      }
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (86400000)) / (3600000));
      const minutes = Math.floor((distance % 3600000) / 60000);
      const seconds = Math.floor((distance % 60000) / 1000);
      document.getElementById('days').innerText = days < 10 ? '0'+days : days;
      document.getElementById('hours').innerText = hours < 10 ? '0'+hours : hours;
      document.getElementById('minutes').innerText = minutes < 10 ? '0'+minutes : minutes;
      document.getElementById('seconds').innerText = seconds < 10 ? '0'+seconds : seconds;
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
    
    const mapBtn = document.getElementById('mapBtn');
    if(mapBtn) {
      mapBtn.addEventListener('click', () => {
        window.open('https://maps.app.goo.gl/FtUNvh9mrf6NnT38A', '_blank');
      });
    }
    
    if(musicControl) {
      musicControl.addEventListener('click', (e) => {
        e.stopPropagation();
        if (bgAudio.paused) {
          bgAudio.play().then(() => {
            musicControl.classList.add('playing');
            bgAudio.currentTime = 3;
          }).catch(() => {});
        } else {
          bgAudio.pause();
          musicControl.classList.remove('playing');
        }
      });
    }
    
    const hero = document.querySelector('.hero');
    if(hero) hero.style.opacity = '1';
  })();
</script>
</body>
</html>
